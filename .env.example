# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pedidos -> Google Sheets (opcional)
LOVABLE_API_KEY=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=

# Rotas de cron
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Migrations (drizzle)
LOVABLE_DB_MIGRATION_URL=

# Mercado Pago (Checkout Pro)
# Access Token do painel do Mercado Pago (Suas integrações > Credenciais).
# Use as credenciais de TESTE em desenvolvimento. Nunca exponha no front-end.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks). Opcional, recomendado.
MP_WEBHOOK_SECRET=
# URL pública do site (ex.: https://kongcode.lovable.app). Sem isso usa a origem da requisição.
SITE_URL=
