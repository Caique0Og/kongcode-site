# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Migrations (drizzle). Connection string do Postgres do Supabase.
# (O nome antigo LOVABLE_DB_MIGRATION_URL ainda é aceito.)
DATABASE_URL=

# Mercado Pago (Pix com QR code no site + Checkout Pro para cartão)
# Access Token do painel do Mercado Pago (Suas integrações > Credenciais).
# Use as credenciais de TESTE em desenvolvimento. Nunca exponha no front-end.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks). Opcional, recomendado.
MP_WEBHOOK_SECRET=
# URL pública do site (ex.: https://kongcode-site.kongcode-site.workers.dev). Sem isso usa a origem da requisição.
SITE_URL=
