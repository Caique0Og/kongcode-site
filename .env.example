# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pedidos -> Google Sheets (opcional). Conta de serviço do Google Cloud com a
# API do Google Sheets ativada; compartilhe a planilha com o e-mail dela como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Campo "private_key" do JSON da conta de serviço (pode manter os 
).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Id da planilha: o trecho do link entre /d/ e /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Aba e colunas (padrão 'Pedidos do site'!A:J).
GOOGLE_SHEETS_RANGE=

# Migrations (drizzle). Connection string do Postgres do Supabase.
# (O nome antigo LOVABLE_DB_MIGRATION_URL ainda é aceito.)
DATABASE_URL=

# Mercado Pago (Pix com QR code no site + Checkout Pro para cartão)
# Access Token do painel do Mercado Pago (Suas integrações > Credenciais).
# Use as credenciais de TESTE em desenvolvimento. Nunca exponha no front-end.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks). Opcional, recomendado.
MP_WEBHOOK_SECRET=
# URL pública do site (ex.: https://kongcode-site.kongcode-site.workers.dev). Sem isso usa a origem da requisição.
SITE_URL=
